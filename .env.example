# ==============================================================================
# AI SQL Database Analyst - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Internal Application Metadata Database (Stores users, saved connections, history)
# SQLite for lightweight local dev; can point to MySQL in production
APP_DATABASE_URL=sqlite:///./app_metadata.db

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Default Target Sample MySQL Database (Configured in Phase 2)
SAMPLE_DB_HOST=127.0.0.1
SAMPLE_DB_PORT=3306
SAMPLE_DB_NAME=ecommerce_db
SAMPLE_DB_USER=root
SAMPLE_DB_PASSWORD=your_mysql_password
